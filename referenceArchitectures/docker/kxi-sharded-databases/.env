# Globals
kxi_registry=portal.dl.kx.com

# Run containers as this user (default: nobody, 65534:65534). Override to run as another user.
DOCKER_UID=65534
DOCKER_GID=65534

# Logging
kxi_log_format=JSON
kxi_log_level=DEBUG

# Database API support
kxi_apis=".kxi.sql,.kxi.qsql,.kxi.sql2"

# Image versions
kxi_db_release=1.19.1
kxi_rt_release=1.19.1
kxi_sidecar_release=1.19.1
kxi_sp_release=1.19.1

# Images
kxi_img_gw=${kxi_registry}/kxi-sg-gw:${kxi_db_release}
kxi_img_rc=${kxi_registry}/kxi-sg-rc:${kxi_db_release}
kxi_img_agg=${kxi_registry}/kxi-sg-agg:${kxi_db_release}
kxi_img_da=${kxi_registry}/kxi-da-single:${kxi_db_release}
kxi_img_sm=${kxi_registry}/kxi-sm-single:${kxi_db_release}
kxi_img_rt=${kxi_registry}/kxi-rt:${kxi_rt_release}
kxi_sidecar=${kxi_registry}/kxi-sidecar:${kxi_sidecar_release}
kxi_sp_controller=${kxi_registry}/kxi-sp-controller:${kxi_sp_release}
kxi_sp_worker=${kxi_registry}/kxi-sp-worker:${kxi_sp_release}

# Ports
kxi_port_rc=5040
kxi_port_agg=5060
kxi_port_gw_qipc=5050
kxi_port_gw_http=8080
kxi_port_da=5080
kxi_port_sm=10001
kxi_port_rt=5000
kxi_port_rt_push_rep=5002
kxi_port_sp_controller=6000
kxi_port_sp_worker=5000

# Directory paths
kxi_dir_config="./config"
kxi_dir_pkgs="./config/packages"
kxi_data_dir=./data

# RT
kxi_rt_replicas=1

# RT Archival configuration - https://code.kx.com/insights/microservices/rt/index.html#archiver
kxi_rt_limit=10Gi
kxi_rt_time=30
kxi_rt_disk=90
#

kxi_rt_heartbeat=10000
kxi_rt_log_size=5
kxi_rt_chunk_size=1

kxi_rt_log_level_console=DEBUG
kxi_rt_quraft_log_level=ERROR

# Volumes
kxi_dir_sidecar_cfg="./config/sidecar-cfg"
kxi_sp_controller_checkpoint="./spScripts/checkpoints/controller:/sp/checkpoints"
kxi_sp_trade_checkpoint="./spScripts/checkpoints/trade:/sp/checkpoints"
kxi_sp_position_checkpoint="./spScripts/checkpoints/positions:/sp/checkpoints"
kx_sp_spec_trade="/app/spScripts/trade_spec.q"
kx_sp_spec_position="/app/spScripts/position_spec.q"
